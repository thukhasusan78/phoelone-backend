# Production: Caddy terminates TLS and proxies to uvicorn on loopback.
# Native systemd: API_UPSTREAM=127.0.0.1:8000 (Caddy default below).
# Optional Docker: set API_UPSTREAM=api:8000 in the compose service env.
phoelone.thukha.online {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
	request_body {
		max_size 2MB
	}
	reverse_proxy {$API_UPSTREAM:127.0.0.1:8000} {
		flush_interval -1
		header_up X-Forwarded-Proto {scheme}
		header_up X-Real-IP {remote_host}
		header_up Host {host}
	}
}
