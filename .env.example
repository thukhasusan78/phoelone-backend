# Public origins advertised to devices. Do not derive these from proxy headers.
PUBLIC_HTTP_ORIGIN=https://phoelone.thukha.online
PUBLIC_WS_ORIGIN=wss://phoelone.thukha.online

# Direct listen (Compose maps 8000). Caddy terminates 80/443 in production.
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
ENVIRONMENT=production

# Database and cache (native systemd on this VPS uses 127.0.0.1).
# Docker Compose overrides these to hostnames postgres / redis.
DATABASE_URL=postgresql+asyncpg://phoe:change-me@127.0.0.1:5432/phoe_lone
REDIS_URL=redis://127.0.0.1:6379/0
POSTGRES_PASSWORD=change-me

# HMAC pepper for hashing WebSocket tokens
AUTH_PEPPER=replace-with-a-long-random-string

# Optional PIN so a second browser can open the companion dashboard without
# a new robot activation code. Empty = cookie from /activate only.
# COMPANION_PIN=
# COMPANION_COOKIE_TTL_S=2592000
# COMPANION_RATE_LIMIT_PER_MINUTE=30

# Production should keep this true so new robots can show a 6-digit portal code.
# They cannot open WebSocket until the code is entered at https://phoelone.thukha.online/
# Set false to reject unknown Device-Id/Client-Id (CLI provision only).
ALLOW_AUTO_PROVISION=true

# Gemini Live (comma-separated keys are rotated on 429/auth failures)
GEMINI_API_KEYS=replace-me
GEMINI_MODEL=gemini-3.1-flash-live-preview

# Server-owned endpointing. Silero distinguishes speech from fan/static.
# Do not use VAD_BACKEND=energy in production.
VAD_BACKEND=silero
VAD_SPEECH_THRESHOLD=0.5
VAD_MIN_SPEECH_MS=180
VAD_MIN_SILENCE_MS=800
VAD_PREROLL_CHUNKS=3
# MAX_FORWARDED_AUDIO_SECONDS=15

# Edge TTS robot voice (Burmese)
TTS_VOICE=my-MM-NilarNeural
TTS_FALLBACK_VOICE=my-MM-ThihaNeural
TTS_RATE=+45%
TTS_PITCH=+100Hz
TTS_VOLUME=+100%

# Myanmar timezone offset in minutes
TIMEZONE_OFFSET_MINUTES=390

# Default city when the user does not name one. Myanmar ISP IPs often geolocate
# to Yangon, so set this to the robot's real city (e.g. Mandalay).
DEFAULT_WEATHER_LOCATION=Mandalay

# Dummy firmware descriptor so the device skips upgrades
FIRMWARE_VERSION=0.0.0
FIRMWARE_URL=https://phoelone.thukha.online/firmware/none.bin

# Optional host-tool credentials. Tools disable cleanly when unset.
TAVILY_KEY=
OPENWEATHER_API_KEY=

# Music: iTunes/Deezer previews are 30s. 0 = play local/full tracks to the end.
# Unrelated full tracks are rejected unless they match the query (relevance threshold).
JAMENDO_CLIENT_ID=
MUSIC_MAX_SECONDS=0
MUSIC_RELEVANCE_THRESHOLD=0.6
# Drop MP3/WAV files named "Artist - Title.ext" here (auto-discovered; no JSON needed).
# MUSIC_LOCAL_DIR=data/local_music
# Optional HTTPS overlay catalog (see data/music_catalog.example.json).
# MUSIC_CATALOG_PATH=/app/data/music_catalog.json
# YouTube via yt-dlp is last-resort only (ToS/ops risk). Default off.
MUSIC_YTDLP_ENABLED=false
# MUSIC_YTDLP_BIN=yt-dlp
# MUSIC_YTDLP_TIMEOUT_S=25
# MUSIC_YTDLP_COOKIES=/app/data/youtube-cookies.txt
# MUSIC_YTDLP_PLAYER_CLIENTS=android,ios,tv

# Optional SMTP for send_email (leave empty to disable)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Operator metrics token (leave empty to disable /metrics auth in local only)
METRICS_TOKEN=

# Caddy
DOMAIN=phoelone.thukha.online
ACME_EMAIL=you@example.com

# 1 vCPU / 2 GB: keep this low (in-process Gemini sessions).
MAX_CONCURRENT_SESSIONS=4
